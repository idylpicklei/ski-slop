---
import Layout from "../../layouts/Layout.astro";
import { FLAGSHIP_RESORTS } from "../../../shared/resorts-seed";

export function getStaticPaths() {
  return FLAGSHIP_RESORTS.map((resort) => ({
    params: { slug: resort.slug },
    props: { resort },
  }));
}

const { resort } = Astro.props;

const pageUrl = Astro.site
  ? new URL(`/resorts/${resort.slug}/`, Astro.site).href
  : `/resorts/${resort.slug}/`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SkiResort",
    name: resort.name,
    description: resort.summary,
    url: pageUrl,
    sameAs: resort.website,
    geo: {
      "@type": "GeoCoordinates",
      latitude: resort.lat,
      longitude: resort.lng,
    },
    address: {
      "@type": "PostalAddress",
      addressCountry: resort.region_slug.startsWith("ca-") ? "CA" : "US",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: Astro.site ? new URL("/", Astro.site).href : "/" },
      { "@type": "ListItem", position: 2, name: "Resorts", item: Astro.site ? new URL("/resorts/", Astro.site).href : "/resorts/" },
      { "@type": "ListItem", position: 3, name: resort.name, item: pageUrl },
    ],
  },
];
---

<Layout
  title={`${resort.name} Ski Resort — Tickets, Trails & Nearby Rentals | Skier Slop`}
  description={`${resort.name}: ${resort.trail_count} trails, ${resort.elevation_ft.toLocaleString()} ft summit. Compare nearby ski rental prices before you go. ${resort.summary}`.slice(0, 300)}
  jsonLd={jsonLd}
>
  <section class="container detail-hero">
    <h1>{resort.name}</h1>
    <p class="meta">{resort.region_slug.toUpperCase()}</p>
    <p>{resort.summary}</p>

    <div class="stats">
      <div class="stat">
        <strong>{resort.trail_count}</strong>
        <span>Trails</span>
      </div>
      <div class="stat">
        <strong>{resort.elevation_ft.toLocaleString()}</strong>
        <span>Summit (ft)</span>
      </div>
      <div class="stat">
        <strong>{resort.lat.toFixed(2)}°, {resort.lng.toFixed(2)}°</strong>
        <span>Coordinates</span>
      </div>
    </div>

    {resort.website && (
      <p><a class="btn" href={resort.website} target="_blank" rel="noopener">Official website</a></p>
    )}
  </section>

  <section class="container">
    <h2 class="section-title">Nearby resorts</h2>
    <div id="nearby-resorts" class="card-grid card-grid-compact">
      <p class="loading">Loading nearby resorts…</p>
    </div>
  </section>

  <section class="container">
    <div class="section-header">
      <h2 class="section-title">Rent skis near {resort.name}</h2>
      <select id="rental-sort" aria-label="Sort rentals">
        <option value="value" selected>Best value</option>
        <option value="price">Cheapest</option>
        <option value="distance">Closest</option>
      </select>
    </div>
    <p class="meta">Compare daily ski rental package prices from shops around the mountain — often cheaper than renting at the base.</p>
    <div id="nearby-rentals" class="card-grid">
      <p class="loading">Loading nearby rentals…</p>
    </div>
  </section>
</Layout>

<script is:inline src="/js/rental-cards.js"></script>
<script is:inline src="/js/resort-detail.js"></script>
<script is:inline define:vars={{ slug: resort.slug, lat: resort.lat, lng: resort.lng }}>
  initResortDetailPage(slug, lat, lng);
</script>
